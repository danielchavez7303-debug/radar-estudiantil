---
import BaseLayout from '../../layouts/BaseLayout.astro';
import oportunidades from '../../data/oportunidades.json';
import '../../styles/catalog.css';
import { catalogRelevanceBase } from '../../lib/catalog-search.js';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const oportunidadesPublicas = oportunidades.filter((oportunidad) => oportunidad.publicar && oportunidad.estadoVerificacion === 'verificada');
const estadoLabel: Record<string, string> = {
	activa: 'Activa',
	proxima: 'Próxima',
	permanente: 'Permanente',
	enProceso: 'En proceso',
	resultados: 'Resultados publicados',
	cerrada: 'Cerrada',
	finalizada: 'Finalizada',
	porVerificar: 'Por verificar',
};

const tipos = [...new Set(oportunidadesPublicas.map((oportunidad) => oportunidad.categoria))];
const areas = [...new Set(oportunidadesPublicas.flatMap((oportunidad) => oportunidad.areas))];
const niveles = [...new Set(oportunidadesPublicas.flatMap((oportunidad) => oportunidad.niveles))];
const costos = [...new Set(oportunidadesPublicas.map((oportunidad) => oportunidad.costo))];
const tiposInstitucion = [...new Set(oportunidadesPublicas.map((oportunidad) => oportunidad.tipoInstitucion))].sort((a, b) => a.localeCompare(b, 'es-MX'));
const entidadesFederativas = [
	"Aguascalientes", "Baja California", "Baja California Sur", "Campeche", "Chiapas", "Chihuahua", "Ciudad de México", "Coahuila", "Colima", "Durango", "Estado de México", "Guanajuato", "Guerrero", "Hidalgo", "Jalisco", "Michoacán", "Morelos", "Nayarit", "Nuevo León", "Oaxaca", "Puebla", "Querétaro", "Quintana Roo", "San Luis Potosí", "Sinaloa", "Sonora", "Tabasco", "Tamaulipas", "Tlaxcala", "Veracruz", "Yucatán", "Zacatecas",
];
const ubicaciones = ['Nacional', 'En línea', ...entidadesFederativas];
const categoriasResumen = Object.entries(
	oportunidadesPublicas.reduce<Record<string, number>>((totales, oportunidad) => {
		totales[oportunidad.categoria] = (totales[oportunidad.categoria] ?? 0) + 1;
		return totales;
	}, {}),
).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es-MX'));
const formatDate = (valor: string | null) =>
	valor ? new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium' }).format(new Date(`${valor}T12:00:00`)) : null;
const searchText = (oportunidad: (typeof oportunidadesPublicas)[number]) =>
	[
		oportunidad.titulo,
		oportunidad.categoria,
		oportunidad.descripcion,
		oportunidad.organizacion,
		oportunidad.tipoInstitucion,
		oportunidad.cobertura,
		oportunidad.modalidad,
		oportunidad.paraQuien,
		oportunidad.costo,
		...oportunidad.areas,
		...oportunidad.niveles,
		...oportunidad.estados,
		...oportunidad.beneficios,
	]
		.join(' ')
		.toLocaleLowerCase('es-MX');
const relevanceBase = catalogRelevanceBase;
---

<BaseLayout
	title="Explorar oportunidades | Radar Estudiantil"
	description="Busca y filtra becas, competencias, cursos y recursos educativos para estudiantes en México."
>
	<main class="catalog-page" id="top">
		<section class="catalog-hero" aria-labelledby="catalogo-titulo">
			<div class="catalog-hero-inner">
				<div>
					<p class="eyebrow eyebrow-light"><span class="eyebrow-dot" aria-hidden="true"></span> Catálogo inicial</p>
					<h1 id="catalogo-titulo">Encuentra algo que te impulse.</h1>
					<p>Busca por palabra, tipo o área. El catálogo crecerá con oportunidades revisadas y organizadas.</p>
				</div>
				<div class="catalog-hero-stat-block">
					<div class="catalog-hero-stat"><strong>{oportunidadesPublicas.length}</strong><span>oportunidades<br />publicadas</span></div>
					<div class="catalog-category-summary" aria-label="Oportunidades por categoría">
						{categoriasResumen.map(([categoria, total]) => <span><strong>{total}</strong> {categoria}</span>)}
					</div>
				</div>
			</div>
		</section>

		<section class="catalog-content" aria-labelledby="resultados-titulo">
			<nav class="catalog-quick-links" aria-label="Atajos para explorar">
				<div class="quick-links-heading">
					<p class="eyebrow">Explora rápido</p>
					<span>Empieza con una ruta sencilla.</span>
				</div>
				<div class="quick-link-list">
					<a class="quick-link" href={`${baseUrl}oportunidades?q=gratuito`}>
						<span class="quick-link-icon" aria-hidden="true">$</span>
						<span><strong>Gratis</strong><small>Sin costo de inscripción</small></span>
						<span class="quick-link-arrow" aria-hidden="true">↗</span>
					</a>
					<a class="quick-link" href={`${baseUrl}oportunidades?q=en%20linea`}>
						<span class="quick-link-icon" aria-hidden="true">⌁</span>
						<span><strong>En línea</strong><small>Aprende desde donde estés</small></span>
						<span class="quick-link-arrow" aria-hidden="true">↗</span>
					</a>
					<a class="quick-link" href={`${baseUrl}oportunidades?q=principiantes`}>
						<span class="quick-link-icon" aria-hidden="true">✦</span>
						<span><strong>Para principiantes</strong><small>Opciones para comenzar</small></span>
						<span class="quick-link-arrow" aria-hidden="true">↗</span>
					</a>
				</div>
			</nav>

			<section class="assistant-radar" aria-labelledby="assistant-radar-title">
				<div class="assistant-radar-head">
					<div>
						<p class="eyebrow">✨ Asistente Radar</p>
						<h2 id="assistant-radar-title">Encuentra opciones que encajen contigo.</h2>
						<p>Usa las oportunidades verificadas del catálogo. No necesitas crear una cuenta.</p>
					</div>
					<button class="assistant-radar-toggle" id="assistant-toggle" type="button" aria-expanded="false" aria-controls="assistant-panel">✨ Abrir Asistente Radar <span aria-hidden="true">↗</span></button>
				</div>
				<div class="assistant-backdrop" id="assistant-backdrop" hidden></div>
				<div class="assistant-radar-panel" id="assistant-panel" role="dialog" aria-modal="true" aria-labelledby="assistant-panel-title" hidden>
					<div class="assistant-panel-topbar">
						<div>
							<span class="assistant-panel-kicker">✨ Radar en línea</span>
							<h3 id="assistant-panel-title">Tu consejero de oportunidades</h3>
							<p>Te orienta con fichas verificadas del catálogo y te dice qué revisar después.</p>
						</div>
						<div class="assistant-panel-actions">
							<button class="assistant-panel-filter" id="assistant-filter-link" type="button">Usar filtros normales</button>
							<button class="assistant-panel-close" id="assistant-close" type="button" aria-label="Cerrar Asistente Radar">×</button>
						</div>
					</div>
					<div class="assistant-panel-scroll">
					<form id="assistant-form" class="assistant-form">
						<div class="assistant-form-grid">
							<label>
								<span>Nivel educativo</span>
								<select name="level">
									<option value="">No estoy seguro</option>
									<option value="Preescolar">Preescolar</option>
									<option value="Primaria">Primaria</option>
									<option value="Secundaria">Secundaria</option>
									<option value="Preparatoria">Preparatoria</option>
									<option value="Universidad">Universidad</option>
									<option value="Posgrado">Posgrado</option>
								</select>
							</label>
							<label>
								<span>Edad <small>(opcional)</small></span>
								<input name="age" type="number" min="5" max="100" inputmode="numeric" placeholder="Ej. 16" />
							</label>
							<label>
								<span>Estado</span>
								<select name="state">
									<option value="">Todo México</option>
									{entidadesFederativas.map((estado) => <option value={estado}>{estado}</option>)}
								</select>
							</label>
							<label>
								<span>Tipo</span>
								<select name="type">
									<option value="">Cualquier tipo</option>
									{tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
								</select>
							</label>
							<label>
								<span>Modalidad</span>
								<select name="modality">
									<option value="">Cualquiera</option>
									<option value="online">En línea</option>
									<option value="presencial">Presencial</option>
									<option value="hibrida">Híbrida o mixta</option>
								</select>
							</label>
							<label class="assistant-checkbox">
								<input name="free" type="checkbox" value="true" />
								<span>Necesito que sea gratuito</span>
							</label>
						</div>
						<label class="assistant-wide-field">
							<span>Intereses <small>(opcional)</small></span>
							<input name="interests" type="text" maxlength="180" placeholder="Ej. matemáticas, programación, arte" />
						</label>
						<label class="assistant-wide-field">
							<span>Escribe tu pregunta <small>(opcional)</small></span>
							<textarea name="message" rows="2" maxlength="800" placeholder="Ej. Busco una beca gratuita de programación… o ¿cuál de estas opciones me conviene más?"></textarea>
						</label>
						<div class="assistant-form-actions">
							<p>Procesamos estos datos solo durante la búsqueda; no guardamos tu perfil ni la conversación.</p>
							<button class="assistant-submit" type="submit">Enviar a Radar <span aria-hidden="true">→</span></button>
						</div>
					</form>
					<div class="assistant-chat" id="assistant-chat" hidden>
						<div class="assistant-chat-intro"><strong>Chat temporal de Radar</strong><span>Pregunta por requisitos, costo o modalidad. No guardamos esta conversación.</span></div>
						<div class="assistant-chat-log" id="assistant-chat-log" role="log" aria-live="polite" aria-label="Conversación con Asistente Radar"></div>
						<div class="assistant-status" id="assistant-status" role="status" aria-live="polite" hidden></div>
						<div class="assistant-results" id="assistant-results" aria-live="polite" hidden>
							<div class="assistant-results-head">
								<div>
									<p class="eyebrow">Resultado Radar</p>
									<h3 id="assistant-results-title">Recomendaciones de Radar</h3>
								</div>
								<button class="assistant-reset" id="assistant-reset" type="button">Nueva búsqueda</button>
							</div>
							<ol class="assistant-recommendations" id="assistant-recommendations"></ol>
							<p class="assistant-source-note" id="assistant-source-note"></p>
						</div>
						<div class="assistant-chat-suggestions" id="assistant-chat-suggestions" aria-label="Preguntas rápidas">
							<button type="button" data-assistant-suggestion="¿Cuál de estas opciones parece más adecuada para mi situación?">¿Cuál me conviene más?</button>
							<button type="button" data-assistant-suggestion="¿Qué requisitos debo revisar primero?">¿Qué requisitos reviso?</button>
							<button type="button" data-assistant-suggestion="¿Cuál es gratuita y cómo funciona su modalidad?">Costo y modalidad</button>
						</div>
					</div>
					</div>
				</div>
			</section>
			<div class="catalog-toolbar">
				<div class="catalog-toolbar-head">
					<div class="catalog-search-wrap" role="search">
						<label for="busqueda">Buscar oportunidades</label>
						<div class="catalog-search">
							<span aria-hidden="true">⌕</span>
							<input id="busqueda" type="search" placeholder="Ej. matemáticas, becas, cursos..." autocomplete="off" />
							<button id="limpiar" type="button" hidden>Limpiar</button>
						</div>
						<p class="catalog-search-hint">Busca por tema, institución, área o nivel.</p>
					</div>
					<button class="filters-toggle" id="toggle-filtros" type="button" aria-expanded="false" aria-controls="catalog-filtros">Mostrar filtros <span aria-hidden="true">＋</span></button>
				</div>
				<div class="catalog-filters" id="catalog-filtros" aria-label="Filtros">
					<label>
						<span>Tipo</span>
						<select id="filtro-tipo">
							<option value="">Todos los tipos</option>
							{tipos.map((tipo) => <option value={tipo}>{tipo}</option>)}
						</select>
					</label>
					<label>
						<span>Área</span>
						<select id="filtro-area">
							<option value="">Todas las áreas</option>
							{areas.map((area) => <option value={area}>{area}</option>)}
						</select>
					</label>
					<label>
						<span>Estado o cobertura</span>
						<select id="filtro-ubicacion">
							<option value="">Todo México y en línea</option>
							{ubicaciones.map((ubicacion) => <option value={ubicacion}>{ubicacion}</option>)}
						</select>
					</label>
					<label>
						<span>Tipo de institución</span>
						<select id="filtro-institucion">
							<option value="">Todas las instituciones</option>
							{tiposInstitucion.map((tipoInstitucion) => <option value={tipoInstitucion}>{tipoInstitucion}</option>)}
						</select>
					</label>
					<label>
						<span>Nivel</span>
						<select id="filtro-nivel">
							<option value="">Todos los niveles</option>
							{niveles.map((nivel) => <option value={nivel}>{nivel}</option>)}
						</select>
					</label>
					<label>
						<span>Vigencia</span>
						<select id="filtro-vigencia">
							<option value="">Cualquier vigencia</option>
							<option value="activa">Activa</option>
							<option value="abiertas">Abiertas ahora</option>
							<option value="proxima">Próxima</option>
							<option value="permanente">Permanente</option>
							<option value="enProceso">En proceso</option>
							<option value="resultados">Resultados publicados</option>
							<option value="cerrada">Cerrada</option>
							<option value="finalizada">Finalizada</option>
						</select>
					</label>
					<label>
						<span>Costo</span>
						<select id="filtro-costo">
							<option value="">Cualquier costo</option>
							<option value="gratis">Gratuito</option>
							<option value="pago">Con costo</option>
						</select>
						</label>
				</div>
				<div class="catalog-filter-presets" id="filtro-presets" aria-label="Atajos de filtrado">
					<span>Atajos:</span>
					<button type="button" class="filter-preset" data-preset="gratis">Gratis</button>
					<button type="button" class="filter-preset" data-preset="abiertas">Abiertas ahora</button>
					<button type="button" class="filter-preset" data-preset="online">En línea</button>
					<button type="button" class="filter-preset" data-preset="nacional">Nacional</button>
				</div>
				<p class="catalog-filter-note">Al elegir un estado aparecen sus oportunidades locales y también las opciones nacionales que aplican en todo México.</p>
			</div>
			<div class="catalog-active-filters" id="filtros-activos" aria-live="polite" hidden></div>

			<div class="catalog-result-bar">
				<div>
					<h2 id="resultados-titulo" aria-live="polite" aria-atomic="true"><span id="resultado-count">{oportunidadesPublicas.length}</span> oportunidades</h2>
					<p id="resultados-ayuda">Las fichas enlazan a una página con detalles, requisitos y fuente oficial.</p>
				</div>
				<div class="catalog-result-tools">
					<label class="favorites-toggle">
						<input id="solo-favoritos" type="checkbox" />
						<span>Solo guardadas</span>
					</label>
					<label class="catalog-sort">
						<span>Ordenar por</span>
						<select id="ordenar">
							<option value="relevancia">Más relevantes</option>
							<option value="az">A–Z</option>
							<option value="verificadas">Recién verificadas</option>
							<option value="cierre">Cierran primero</option>
						</select>
					</label>
				</div>
			</div>

			<div class="catalog-grid" id="catalog-grid">
				{
					oportunidadesPublicas.map((oportunidad, index) => (
						<article
							class={`opportunity-card opportunity-${oportunidad.id}`}
							data-opportunity
							data-search={searchText(oportunidad)}
							data-tipo={oportunidad.categoria}
							data-area={oportunidad.areas.join('|')}
							data-ubicacion={[...new Set([...oportunidad.estados, oportunidad.cobertura])].join('|')}
							data-cobertura={oportunidad.cobertura}
							data-institucion={oportunidad.tipoInstitucion}
							data-nivel={oportunidad.niveles.join('|')}
							data-organizacion={oportunidad.organizacion}
							data-estado={oportunidad.estado}
							data-costo={oportunidad.costo}
							data-modalidad={oportunidad.modalidad}
							data-edad-minima={oportunidad.edadMinima ?? ''}
							data-edad-maxima={oportunidad.edadMaxima ?? ''}
							data-index={index}
							data-titulo={oportunidad.titulo}
							data-slug={oportunidad.slug}
							data-cierre={oportunidad.fechaCierre ?? ''}
							data-enlace-convocatoria={oportunidad.enlaceConvocatoria ?? ''}
							data-sitio-oficial={oportunidad.sitioOficial ?? ''}
							data-verificacion={oportunidad.ultimaVerificacion ?? ''}
							data-base-score={relevanceBase(oportunidad)}
						>
							<button class="favorite-button" data-favorite-button type="button" aria-pressed="false" aria-label={`Guardar ${oportunidad.titulo}`}>
								<span class="favorite-icon" aria-hidden="true">♡</span><span class="favorite-button-label">Guardar</span>
							</button>
							<div class="opportunity-card-topline">
								<span class="opportunity-type">{oportunidad.categoria}</span>
								<span class="opportunity-status">{estadoLabel[oportunidad.estado] ?? oportunidad.estado}</span>
							</div>
							<h3><a href={`${baseUrl}oportunidades/${oportunidad.slug}`}>{oportunidad.titulo}</a></h3>
							<p>{oportunidad.descripcion}</p>
							<div class="opportunity-details">
								<span><strong>Para:</strong> {oportunidad.niveles.slice(0, 2).join(' · ')}</span>
								<span><strong>Alcance:</strong> {oportunidad.cobertura}</span>
								<span><strong>Modalidad:</strong> {oportunidad.modalidad}</span>
								<span><strong>Costo:</strong> {oportunidad.costo}</span>
								{formatDate(oportunidad.fechaCierre) && <span><strong>Cierra:</strong> {formatDate(oportunidad.fechaCierre)}</span>}
							</div>
							<div class="opportunity-verification"><span aria-hidden="true">✓</span> Verificada {formatDate(oportunidad.ultimaVerificacion)}</div>
							<div class="opportunity-card-footer">
								<span>{oportunidad.organizacion}</span>
								<a href={`${baseUrl}oportunidades/${oportunidad.slug}`} aria-label={`Ver detalles de ${oportunidad.titulo}`}>Ver ficha <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					))
				}
			</div>

			<div class="catalog-empty" id="catalog-empty" hidden>
				<span aria-hidden="true">⌕</span>
				<h2 id="catalog-empty-title">No encontramos coincidencias.</h2>
				<p id="catalog-empty-copy">Prueba con otra palabra o limpia los filtros para ver todo el catálogo.</p>
				<button class="empty-action" id="empty-clear" type="button">Restablecer búsqueda</button>
			</div>
			<div class="catalog-state catalog-loading" id="catalog-loading" role="status" hidden>
				<span class="catalog-state-icon" aria-hidden="true">◌</span>
				<p>Cargando oportunidades…</p>
			</div>
			<div class="catalog-state catalog-error" id="catalog-error" role="alert" hidden>
				<span class="catalog-state-icon" aria-hidden="true">!</span>
				<div><strong>No pudimos actualizar los resultados.</strong><p>Intenta recargar la página para volver a explorar el catálogo.</p></div>
				<button class="empty-action" id="catalog-retry" type="button">Reintentar</button>
			</div>
			<p class="catalog-disclaimer"><span aria-hidden="true">✦</span> Esta colección es inicial. Antes de participar, confirma fechas y requisitos en la fuente oficial.</p>
		</section>
	</main>

	<script>
		const searchInput = document.querySelector<HTMLInputElement>('#busqueda');
		const typeFilter = document.querySelector<HTMLSelectElement>('#filtro-tipo');
		const areaFilter = document.querySelector<HTMLSelectElement>('#filtro-area');
		const locationFilter = document.querySelector<HTMLSelectElement>('#filtro-ubicacion');
		const institutionFilter = document.querySelector<HTMLSelectElement>('#filtro-institucion');
		const levelFilter = document.querySelector<HTMLSelectElement>('#filtro-nivel');
		const statusFilter = document.querySelector<HTMLSelectElement>('#filtro-vigencia');
		const costFilter = document.querySelector<HTMLSelectElement>('#filtro-costo');
		const sortSelect = document.querySelector<HTMLSelectElement>('#ordenar');
		const clearButton = document.querySelector<HTMLButtonElement>('#limpiar');
		const emptyClearButton = document.querySelector<HTMLButtonElement>('#empty-clear');
		const filtersToggle = document.querySelector<HTMLButtonElement>('#toggle-filtros');
		const filterPresets = [...document.querySelectorAll<HTMLButtonElement>('[data-preset]')];
		const filtersPanel = document.querySelector<HTMLElement>('#catalog-filtros');
		const activeFilters = document.querySelector<HTMLElement>('#filtros-activos');
		const favoritesOnly = document.querySelector<HTMLInputElement>('#solo-favoritos');
		const emptyTitle = document.querySelector<HTMLElement>('#catalog-empty-title');
		const emptyCopy = document.querySelector<HTMLElement>('#catalog-empty-copy');
		const count = document.querySelector<HTMLElement>('#resultado-count');
		const resultsHelp = document.querySelector<HTMLElement>('#resultados-ayuda');
		const emptyState = document.querySelector<HTMLElement>('#catalog-empty');
		const loadingState = document.querySelector<HTMLElement>('#catalog-loading');
		const errorState = document.querySelector<HTMLElement>('#catalog-error');
		const retryButton = document.querySelector<HTMLButtonElement>('#catalog-retry');
		const grid = document.querySelector<HTMLElement>('#catalog-grid');
		const cards = [...document.querySelectorAll<HTMLElement>('[data-opportunity]')];
		const favoriteButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-favorite-button]')];
		const favoriteStorageKey = 'radar-estudiantil:favoritos';
		let favorites = new Set<string>();
		try {
			favorites = new Set(JSON.parse(window.localStorage.getItem(favoriteStorageKey) ?? '[]'));
		} catch {
			favorites = new Set();
		}

		import { catalogRelevanceScore, matchesCatalogFilters, normalizeText as normalize } from '../../lib/catalog-search.js';
		const params = new URLSearchParams(window.location.search);
		if (searchInput) searchInput.value = params.get('q') ?? '';
		if (typeFilter) typeFilter.value = params.get('tipo') ?? '';
		if (areaFilter) areaFilter.value = params.get('area') ?? '';
		if (locationFilter) locationFilter.value = params.get('ubicacion') ?? '';
		if (institutionFilter) institutionFilter.value = params.get('institucion') ?? '';
		if (levelFilter) levelFilter.value = params.get('nivel') ?? '';
		if (statusFilter) statusFilter.value = params.get('vigencia') ?? '';
		if (costFilter) costFilter.value = params.get('costo') ?? '';
		if (favoritesOnly) favoritesOnly.checked = params.get('favoritos') === '1';
		if (sortSelect) sortSelect.value = params.get('orden') ?? 'relevancia';
		if (filtersPanel && (params.toString() || window.innerWidth > 700)) filtersPanel.classList.add('is-open');
		if (filtersToggle && filtersPanel?.classList.contains('is-open')) {
			filtersToggle.setAttribute('aria-expanded', 'true');
			filtersToggle.innerHTML = 'Ocultar filtros <span aria-hidden="true">−</span>';
		}

		const syncUrl = () => {
			const nextParams = new URLSearchParams();
			[
				['q', searchInput?.value ?? ''],
				['tipo', typeFilter?.value ?? ''],
				['area', areaFilter?.value ?? ''],
				['ubicacion', locationFilter?.value ?? ''],
				['institucion', institutionFilter?.value ?? ''],
				['nivel', levelFilter?.value ?? ''],
				['vigencia', statusFilter?.value ?? ''],
				['costo', costFilter?.value ?? ''],
			].forEach(([key, value]) => {
				if (value) nextParams.set(key, value);
			});
			if (favoritesOnly?.checked) nextParams.set('favoritos', '1');
			if (sortSelect?.value && sortSelect.value !== 'relevancia') nextParams.set('orden', sortSelect.value);
			const queryString = nextParams.toString();
			window.history.replaceState(window.history.state, '', `${window.location.pathname}${queryString ? `?${queryString}` : ''}${window.location.hash}`);
		};

		const saveFavorites = () => {
			try {
				window.localStorage.setItem(favoriteStorageKey, JSON.stringify([...favorites]));
			} catch {
				// El catálogo sigue funcionando aunque el navegador bloquee el almacenamiento local.
			}
		};

		const updateFavoriteButton = (button: HTMLButtonElement) => {
			const card = button.closest<HTMLElement>('[data-opportunity]');
			const slug = card?.dataset.slug ?? '';
			const isFavorite = favorites.has(slug);
			button.setAttribute('aria-pressed', String(isFavorite));
			button.setAttribute('aria-label', `${isFavorite ? 'Quitar de' : 'Guardar en'} tus oportunidades guardadas`);
			const icon = button.querySelector<HTMLElement>('.favorite-icon');
			const label = button.querySelector<HTMLElement>('.favorite-button-label');
			if (icon) icon.textContent = isFavorite ? '♥' : '♡';
			if (label) label.textContent = isFavorite ? 'Guardada' : 'Guardar';
		};

		favoriteButtons.forEach((button) => {
			updateFavoriteButton(button);
			button.addEventListener('click', () => {
				const card = button.closest<HTMLElement>('[data-opportunity]');
				const slug = card?.dataset.slug ?? '';
				if (!slug) return;
				if (favorites.has(slug)) favorites.delete(slug);
				else favorites.add(slug);
				saveFavorites();
				updateFavoriteButton(button);
				updateResults();
			});
		});

		const renderActiveFilters = () => {
			if (!activeFilters) return;
			activeFilters.replaceChildren();
			const selected = [
				{ key: 'q', label: 'Búsqueda', value: searchInput?.value ?? '' },
				{ key: 'tipo', label: 'Tipo', value: typeFilter?.value ?? '' },
				{ key: 'area', label: 'Área', value: areaFilter?.value ?? '' },
				{ key: 'ubicacion', label: 'Estado o cobertura', value: locationFilter?.value ?? '' },
				{ key: 'institucion', label: 'Institución', value: institutionFilter?.value ?? '' },
				{ key: 'nivel', label: 'Nivel', value: levelFilter?.value ?? '' },
				{ key: 'vigencia', label: 'Vigencia', value: statusFilter?.value ?? '' },
				{ key: 'costo', label: 'Costo', value: costFilter?.value ?? '' },
				{ key: 'favoritos', label: 'Vista', value: favoritesOnly?.checked ? 'Solo guardadas' : '' },
			].filter((item) => item.value);
			selected.forEach((item) => {
				const chip = document.createElement('button');
				chip.type = 'button';
				chip.className = 'filter-chip';
				chip.dataset.clearFilter = item.key;
				chip.setAttribute('aria-label', `Quitar filtro ${item.label}`);
				const text = document.createElement('span');
				text.textContent = `${item.label}: ${item.value}`;
				const close = document.createElement('span');
				close.setAttribute('aria-hidden', 'true');
				close.textContent = '×';
				chip.append(text, close);
				activeFilters.append(chip);
			});
			if (selected.length > 1) {
				const clearAll = document.createElement('button');
				clearAll.type = 'button';
				clearAll.className = 'filter-chip filter-chip-clear';
				clearAll.dataset.clearFilter = 'all';
				clearAll.textContent = 'Limpiar todo';
				activeFilters.append(clearAll);
			}
			activeFilters.hidden = selected.length === 0;
		};

		const sortCards = () => {
			if (!grid || !sortSelect) return;
			const sorted = [...cards].sort((a, b) => {
				if (sortSelect.value === 'az') return (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '', 'es-MX');
				if (sortSelect.value === 'verificadas') {
					const verificationDifference = (b.dataset.verificacion ?? '').localeCompare(a.dataset.verificacion ?? '');
					return verificationDifference || (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '', 'es-MX');
				}
				if (sortSelect.value === 'cierre') {
					const aClosed = ['cerrada', 'finalizada', 'resultados'].includes(a.dataset.estado ?? '');
					const bClosed = ['cerrada', 'finalizada', 'resultados'].includes(b.dataset.estado ?? '');
					if (aClosed !== bClosed) return aClosed ? 1 : -1;
					const aDate = a.dataset.cierre ? Date.parse(a.dataset.cierre) : Number.POSITIVE_INFINITY;
					const bDate = b.dataset.cierre ? Date.parse(b.dataset.cierre) : Number.POSITIVE_INFINITY;
					return (aDate - bDate) || (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '', 'es-MX');
				}
				const scoreDifference = Number(b.dataset.score ?? 0) - Number(a.dataset.score ?? 0);
				if (scoreDifference !== 0) return scoreDifference;
				return (a.dataset.titulo ?? '').localeCompare(b.dataset.titulo ?? '', 'es-MX');
			});
			sorted.forEach((card) => grid.append(card));
		};

		const cardMeta = (card: HTMLElement) => ({
			slug: card.dataset.slug ?? '',
			titulo: card.dataset.titulo ?? '',
			categoria: card.dataset.tipo ?? '',
			areas: (card.dataset.area ?? '').split('|').filter(Boolean),
			ubicacion: (card.dataset.ubicacion ?? '').split('|').filter(Boolean),
			cobertura: card.dataset.cobertura ?? '',
			institucion: card.dataset.institucion ?? '',
			nivel: (card.dataset.nivel ?? '').split('|').filter(Boolean),
			organizacion: card.dataset.organizacion ?? '',
			estado: card.dataset.estado ?? '',
			costo: card.dataset.costo ?? '',
			modalidad: card.dataset.modalidad ?? '',
			search: card.dataset.search ?? '',
			baseScore: Number(card.dataset.baseScore ?? 0),
		});

		const relevanceScore = (card: HTMLElement, query: string) => catalogRelevanceScore(cardMeta(card), query);

		const showCatalogError = () => {
			if (errorState) errorState.hidden = false;
			if (emptyState) emptyState.hidden = true;
			if (grid) grid.setAttribute('aria-busy', 'false');
		};

		const updateResults = () => {
			try {
				const query = searchInput?.value ?? '';
				const selectedFavorites = favoritesOnly?.checked ?? false;
				const filters = {
					query,
					type: typeFilter?.value ?? '',
					area: areaFilter?.value ?? '',
					location: locationFilter?.value ?? '',
					institution: institutionFilter?.value ?? '',
					level: levelFilter?.value ?? '',
					status: statusFilter?.value ?? '',
					cost: costFilter?.value ?? '',
					favoritesOnly: selectedFavorites,
					favorites,
				};
				let visible = 0;
				cards.forEach((card) => {
					const meta = cardMeta(card);
					const matches = matchesCatalogFilters(meta, filters);
					card.dataset.score = String(relevanceScore(card, query));
					card.hidden = !matches;
					if (matches) visible += 1;
				});
				if (count) count.textContent = String(visible);
				if (resultsHelp) {
					resultsHelp.textContent = visible === cards.length
						? 'Las fichas enlazan a una página con detalles, requisitos y fuente oficial.'
						: `Mostrando ${visible} de ${cards.length} oportunidades. Ajusta los filtros para ampliar o afinar la búsqueda.`;
				}
				if (emptyState) emptyState.hidden = visible !== 0;
				if (emptyTitle) emptyTitle.textContent = selectedFavorites ? 'Todavía no tienes guardadas.' : 'No encontramos coincidencias.';
				if (emptyCopy) emptyCopy.textContent = selectedFavorites
					? 'Guarda una oportunidad con el corazón para verla aquí cuando vuelvas.'
					: 'Prueba con otra palabra, cambia un filtro o restablece la búsqueda.';
				if (clearButton) clearButton.hidden = !query && !typeFilter?.value && !areaFilter?.value && !locationFilter?.value && !institutionFilter?.value && !levelFilter?.value && !statusFilter?.value && !costFilter?.value && !selectedFavorites;
				renderActiveFilters();
				syncUrl();
				sortCards();
				if (errorState) errorState.hidden = true;
			} catch {
				showCatalogError();
			}
		};

		const resetFilters = () => {
			if (searchInput) searchInput.value = '';
			if (typeFilter) typeFilter.value = '';
			if (areaFilter) areaFilter.value = '';
			if (locationFilter) locationFilter.value = '';
			if (institutionFilter) institutionFilter.value = '';
			if (levelFilter) levelFilter.value = '';
			if (statusFilter) statusFilter.value = '';
			if (costFilter) costFilter.value = '';
			if (favoritesOnly) favoritesOnly.checked = false;
			if (sortSelect) sortSelect.value = 'relevancia';
			updateResults();
			searchInput?.focus();
		};

		searchInput?.addEventListener('input', updateResults);
		typeFilter?.addEventListener('change', updateResults);
		areaFilter?.addEventListener('change', updateResults);
		locationFilter?.addEventListener('change', updateResults);
		institutionFilter?.addEventListener('change', updateResults);
		levelFilter?.addEventListener('change', updateResults);
		statusFilter?.addEventListener('change', updateResults);
		costFilter?.addEventListener('change', updateResults);
		favoritesOnly?.addEventListener('change', updateResults);
		sortSelect?.addEventListener('change', () => {
			sortCards();
			syncUrl();
		});
		clearButton?.addEventListener('click', resetFilters);
		emptyClearButton?.addEventListener('click', resetFilters);
		filtersToggle?.addEventListener('click', () => {
			if (!filtersPanel) return;
			const isOpen = filtersPanel.classList.toggle('is-open');
			filtersToggle.setAttribute('aria-expanded', String(isOpen));
			filtersToggle.innerHTML = `${isOpen ? 'Ocultar' : 'Mostrar'} filtros <span aria-hidden="true">${isOpen ? '−' : '＋'}</span>`;
		});
		activeFilters?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-clear-filter]');
			const key = button?.dataset.clearFilter;
			if (!key) return;
			if (key === 'all') {
				resetFilters();
				return;
			}
			if (key === 'q' && searchInput) searchInput.value = '';
			if (key === 'tipo' && typeFilter) typeFilter.value = '';
			if (key === 'area' && areaFilter) areaFilter.value = '';
			if (key === 'ubicacion' && locationFilter) locationFilter.value = '';
			if (key === 'institucion' && institutionFilter) institutionFilter.value = '';
			if (key === 'nivel' && levelFilter) levelFilter.value = '';
			if (key === 'vigencia' && statusFilter) statusFilter.value = '';
			if (key === 'costo' && costFilter) costFilter.value = '';
			if (key === 'favoritos' && favoritesOnly) favoritesOnly.checked = false;
			updateResults();
		});
		filterPresets.forEach((button) => {
			button.addEventListener('click', () => {
				const preset = button.dataset.preset;
				if (preset === 'gratis' && costFilter) costFilter.value = 'gratis';
				if (preset === 'abiertas' && statusFilter) statusFilter.value = 'abiertas';
				if (preset === 'online' && locationFilter) locationFilter.value = 'En línea';
				if (preset === 'nacional' && locationFilter) locationFilter.value = 'Nacional';
				filtersPanel?.classList.add('is-open');
				filtersToggle?.setAttribute('aria-expanded', 'true');
				if (filtersToggle) filtersToggle.innerHTML = 'Ocultar filtros <span aria-hidden="true">−</span>';
				updateResults();
			});
		});
		window.addEventListener('popstate', () => {
			const nextParams = new URLSearchParams(window.location.search);
			if (searchInput) searchInput.value = nextParams.get('q') ?? '';
			if (typeFilter) typeFilter.value = nextParams.get('tipo') ?? '';
			if (areaFilter) areaFilter.value = nextParams.get('area') ?? '';
			if (locationFilter) locationFilter.value = nextParams.get('ubicacion') ?? '';
			if (institutionFilter) institutionFilter.value = nextParams.get('institucion') ?? '';
			if (levelFilter) levelFilter.value = nextParams.get('nivel') ?? '';
			if (statusFilter) statusFilter.value = nextParams.get('vigencia') ?? '';
			if (costFilter) costFilter.value = nextParams.get('costo') ?? '';
			if (favoritesOnly) favoritesOnly.checked = nextParams.get('favoritos') === '1';
			if (sortSelect) sortSelect.value = nextParams.get('orden') ?? 'relevancia';
			updateResults();
		});
		retryButton?.addEventListener('click', () => window.location.reload());
		grid?.setAttribute('aria-busy', 'true');
		loadingState?.removeAttribute('hidden');
		window.requestAnimationFrame(() => {
			sortCards();
			updateResults();
			loadingState?.setAttribute('hidden', '');
		});
	</script>

	<script>
		const assistantRoot = document.querySelector<HTMLElement>('.assistant-radar');
		const assistantToggle = document.querySelector<HTMLButtonElement>('#assistant-toggle');
		const assistantPanel = document.querySelector<HTMLElement>('#assistant-panel');
		const assistantBackdrop = document.querySelector<HTMLElement>('#assistant-backdrop');
		const assistantClose = document.querySelector<HTMLButtonElement>('#assistant-close');
		const assistantFilterLink = document.querySelector<HTMLButtonElement>('#assistant-filter-link');
		const assistantForm = document.querySelector<HTMLFormElement>('#assistant-form');
		const assistantStatus = document.querySelector<HTMLElement>('#assistant-status');
		const assistantResults = document.querySelector<HTMLElement>('#assistant-results');
		const assistantResultsTitle = document.querySelector<HTMLElement>('#assistant-results-title');
		const assistantRecommendations = document.querySelector<HTMLOListElement>('#assistant-recommendations');
		const assistantSourceNote = document.querySelector<HTMLElement>('#assistant-source-note');
		const assistantReset = document.querySelector<HTMLButtonElement>('#assistant-reset');
		const assistantMessageField = assistantForm?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
		const assistantChat = document.querySelector<HTMLElement>('#assistant-chat');
		const assistantChatLog = document.querySelector<HTMLElement>('#assistant-chat-log');
		const assistantSuggestions = document.querySelector<HTMLElement>('#assistant-chat-suggestions');
		const assistantEndpoint = '/api/asistente';
		let assistantConversation: Array<{ role: 'user' | 'assistant'; content: string }> = [];
		let assistantWelcomeShown = false;

		const setAssistantStatus = (message, tone = 'info') => {
			if (!assistantStatus) return;
			assistantStatus.textContent = message;
			assistantStatus.dataset.tone = tone;
			assistantStatus.hidden = !message;
		};

		const appendAssistantMessage = (role: 'user' | 'assistant', text: string) => {
			if (!assistantChat || !assistantChatLog || !text) return;
			assistantChat.hidden = false;
			const bubble = document.createElement('div');
			bubble.className = `assistant-chat-message is-${role}`;
			bubble.textContent = text;
			if (role === 'assistant') bubble.setAttribute('role', 'status');
			assistantChatLog.append(bubble);
			assistantChatLog.scrollTop = assistantChatLog.scrollHeight;
		};

		const assistantReplyText = (payload) => payload.message
			|| 'Encontré opciones verificadas en Radar. Revisa las fichas y sus requisitos antes de postularte.';

		const createCriteria = (compatibility = {}) => {
			const criteria = document.createElement('div');
			criteria.className = 'assistant-criteria';
			const add = (items, className, prefix) => {
				(items ?? []).forEach((item) => {
					const chip = document.createElement('span');
					chip.className = className;
					chip.textContent = `${prefix} ${item}`;
					criteria.append(chip);
				});
			};
			add(compatibility.coinciden, 'is-match', '✓');
			add(compatibility.noCoinciden, 'is-mismatch', '−');
			add(compatibility.desconocidos, 'is-unknown', '?');
			return criteria.childElementCount ? criteria : null;
		};

		const renderAssistantRecommendations = (payload) => {
			if (!assistantRecommendations || !assistantResults) return;
			assistantRecommendations.replaceChildren();
			(payload.recommendations ?? []).forEach((recommendation) => {
				const item = document.createElement('li');
				const body = document.createElement('div');
				const title = document.createElement('a');
				title.className = 'assistant-recommendation-title';
				title.href = recommendation.url || `/oportunidades/${encodeURIComponent(recommendation.slug ?? '')}`;
				title.textContent = recommendation.titulo || 'Oportunidad';
				body.append(title);
				const reason = document.createElement('p');
				reason.className = 'assistant-recommendation-reason';
				reason.textContent = recommendation.reason || recommendation.compatibilidad?.resumen || 'Coincidencia encontrada por Radar.';
				body.append(reason);
				const criteria = createCriteria(recommendation.compatibilidad);
				if (criteria) body.append(criteria);
				if (recommendation.warning) {
					const warning = document.createElement('p');
					warning.className = 'assistant-recommendation-warning';
					warning.textContent = `Aviso: ${recommendation.warning}`;
					body.append(warning);
				}
				const actions = document.createElement('div');
				actions.className = 'assistant-recommendation-actions';
				const radarLink = document.createElement('a');
				radarLink.className = 'assistant-recommendation-link';
				radarLink.href = title.href;
				radarLink.textContent = 'Abrir ficha en Radar ↗';
				actions.append(radarLink);
				const officialUrl = [recommendation.enlaceConvocatoria, recommendation.sitioOficial]
					.map((value) => String(value ?? '').trim())
					.find((value) => value.startsWith('https://') || value.startsWith('http://'));
				if (officialUrl) {
					const officialLink = document.createElement('a');
					officialLink.className = 'assistant-recommendation-official';
					officialLink.href = officialUrl;
					officialLink.target = '_blank';
					officialLink.rel = 'noopener noreferrer';
					officialLink.title = 'Consulta requisitos y participa en el sitio oficial';
					officialLink.textContent = 'Ir al sitio oficial ↗';
					actions.append(officialLink);
				}
				body.append(actions);
				item.append(body);
				assistantRecommendations.append(item);
			});
			assistantResults.hidden = false;
			if (assistantResultsTitle) assistantResultsTitle.textContent = 'Recomendaciones de Radar';
			if (assistantSourceNote) assistantSourceNote.textContent = payload.sourceNote || 'Confirma siempre los datos en la fuente oficial.';
		};

		const clientFallback = (profile = {}) => {
			const normalizeAssistant = (value) => String(value ?? '').toLocaleLowerCase('es-MX').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
			const wantedLevel = normalizeAssistant(profile.level);
			const wantedState = normalizeAssistant(profile.state);
			const wantedInterests = normalizeAssistant(profile.interests);
			const wantedType = normalizeAssistant(profile.type);
			const wantedModality = normalizeAssistant(profile.modality);
			const wantedAge = String(profile.age ?? '').trim() ? Number(profile.age) : null;
			const fallbackRecommendations = [...document.querySelectorAll<HTMLElement>('[data-opportunity]')]
				.filter((card) => {
					const status = card.dataset.estado ?? '';
					if (status === 'cerrada' || status === 'finalizada' || status === 'resultados') return false;
					const levels = normalizeAssistant(card.dataset.nivel).replaceAll('|', ' ');
					const locations = normalizeAssistant(card.dataset.ubicacion).replaceAll('|', ' ');
					const cost = normalizeAssistant(card.dataset.costo);
					const modality = normalizeAssistant(card.dataset.modalidad);
					const minimumAge = card.dataset.edadMinima ? Number(card.dataset.edadMinima) : null;
					const maximumAge = card.dataset.edadMaxima ? Number(card.dataset.edadMaxima) : null;
					const stateMatch = !wantedState || locations.includes(wantedState) || locations.includes('nacional') || normalizeAssistant(card.dataset.search).includes('mexico');
					const levelMatch = !wantedLevel || levels.includes(wantedLevel) || (wantedLevel.includes('preparatoria') && levels.includes('bachillerato')) || (wantedLevel.includes('bachillerato') && levels.includes('preparatoria')) || levels.includes('todos los niveles');
					const interestMatch = !wantedInterests || normalizeAssistant(card.dataset.search).split(/[,;\s]+/).some((token) => token && wantedInterests.includes(token));
					const freeMatch = !profile.free || cost.includes('gratuito') || cost.includes('gratis') || cost.includes('sin costo') || cost.includes('sin cuota');
					const typeMatch = !wantedType || normalizeAssistant(card.dataset.tipo).includes(wantedType);
					const modalityMatch = !wantedModality || (wantedModality === 'online' ? /en linea|autodirigida|descargable/.test(modality) : wantedModality === 'presencial' ? /presencial|plantel|clase/.test(modality) : /hibrida|mixta/.test(modality));
					const ageMatch = !Number.isInteger(wantedAge) || ((minimumAge === null || !Number.isFinite(minimumAge) || wantedAge >= minimumAge) && (maximumAge === null || !Number.isFinite(maximumAge) || wantedAge <= maximumAge));
					return stateMatch && levelMatch && interestMatch && freeMatch && typeMatch && modalityMatch && ageMatch;
				})
				.sort((a, b) => Number(b.dataset.baseScore ?? 0) - Number(a.dataset.baseScore ?? 0))
				.slice(0, 5)
				.map((card) => ({
					slug: card.dataset.slug,
					titulo: card.dataset.titulo,
					url: `/oportunidades/${encodeURIComponent(card.dataset.slug ?? '')}`,
					enlaceConvocatoria: card.dataset.enlaceConvocatoria || null,
					sitioOficial: card.dataset.sitioOficial || null,
					reason: 'Está activa y disponible en el catálogo; revisa sus requisitos en la ficha.',
					compatibilidad: { desconocidos: ['Perfil no disponible temporalmente'] },
				}));
			return {
				mode: 'fallback',
				recommendations: fallbackRecommendations,
				message: 'Encontré estas opciones verificadas con el ranking local del catálogo.',
				sourceNote: 'Puedes seguir explorando con los filtros normales. Confirma siempre los datos en la fuente oficial.',
			};
		};

		const showAssistantWelcome = () => {
			if (assistantWelcomeShown || !assistantChatLog) return;
			assistantWelcomeShown = true;
			appendAssistantMessage('assistant', 'Hola. Soy el Asistente Radar. Dime tu nivel, estado, intereses y si necesitas algo gratuito; te recomendaré fichas concretas.');
		};

		const openAssistant = () => {
			if (!assistantPanel) return;
			assistantPanel.hidden = false;
			if (assistantBackdrop) assistantBackdrop.hidden = false;
			assistantRoot?.classList.add('is-open');
			document.body.classList.add('assistant-open');
			assistantToggle?.setAttribute('aria-expanded', 'true');
			if (assistantToggle) assistantToggle.innerHTML = 'Cerrar asistente <span aria-hidden="true">×</span>';
			showAssistantWelcome();
			window.setTimeout(() => assistantMessageField?.focus(), 40);
		};

		const closeAssistant = () => {
			if (!assistantPanel) return;
			assistantPanel.hidden = true;
			if (assistantBackdrop) assistantBackdrop.hidden = true;
			assistantRoot?.classList.remove('is-open');
			document.body.classList.remove('assistant-open');
			assistantToggle?.setAttribute('aria-expanded', 'false');
			if (assistantToggle) assistantToggle.innerHTML = '✨ Abrir Asistente Radar <span aria-hidden="true">↗</span>';
			assistantToggle?.focus();
		};

		assistantToggle?.addEventListener('click', () => {
			if (assistantPanel?.hidden) openAssistant();
			else closeAssistant();
		});
		assistantClose?.addEventListener('click', closeAssistant);
		assistantBackdrop?.addEventListener('click', closeAssistant);
		assistantFilterLink?.addEventListener('click', () => {
			closeAssistant();
			document.querySelector('#busqueda')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
			document.querySelector<HTMLInputElement>('#busqueda')?.focus();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && assistantPanel && !assistantPanel.hidden) closeAssistant();
		});

		assistantSuggestions?.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-assistant-suggestion]');
			if (!button || !assistantMessageField) return;
			assistantMessageField.value = button.dataset.assistantSuggestion ?? '';
			assistantMessageField.focus();
		});

		assistantForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			const submit = assistantForm.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (submit) submit.disabled = true;
			setAssistantStatus('Revisando requisitos y ordenando oportunidades verificadas…');
			const formData = new FormData(assistantForm);
			const message = String(formData.get('message') ?? '').trim();
			const previousConversation = assistantConversation.slice(-6);
			if (message) {
				appendAssistantMessage('user', message);
				assistantConversation = [...assistantConversation, { role: 'user', content: message }].slice(-6);
			}
			const profile = {
				level: String(formData.get('level') ?? ''),
				age: String(formData.get('age') ?? ''),
				state: String(formData.get('state') ?? ''),
				interests: String(formData.get('interests') ?? ''),
				type: String(formData.get('type') ?? ''),
				modality: String(formData.get('modality') ?? ''),
				free: formData.get('free') === 'true',
			};
			try {
				const response = await fetch(assistantEndpoint, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ message, profile, history: previousConversation }),
				});
				const payload = await response.json();
				if (!response.ok && payload.mode !== 'rate-limit') throw new Error(payload.message || 'No se pudo completar la búsqueda.');
				const reply = assistantReplyText(payload);
				if (reply) {
					appendAssistantMessage('assistant', reply);
					assistantConversation = [...assistantConversation, { role: 'assistant', content: reply }].slice(-6);
				}
				renderAssistantRecommendations(payload);
				const statusMessage = payload.mode === 'ai'
					? 'Explicación generada usando únicamente las candidatas de Radar.'
					: payload.mode === 'rate-limit'
						? 'Límite temporal alcanzado; estas opciones salen del ranking de Radar.'
						: 'Estas recomendaciones salen del ranking verificable de Radar.';
				setAssistantStatus(statusMessage, payload.mode === 'ai' ? 'success' : 'fallback');
			} catch {
				const payload = clientFallback(profile);
				const reply = assistantReplyText(payload);
				if (reply) {
					appendAssistantMessage('assistant', reply);
					assistantConversation = [...assistantConversation, { role: 'assistant', content: reply }].slice(-6);
				}
				renderAssistantRecommendations(payload);
				setAssistantStatus('No pudimos conectar con el Asistente Radar. Mostramos el ranking local del catálogo; puedes seguir usando los filtros.', 'fallback');
			}
			if (submit) submit.disabled = false;
		});

		assistantReset?.addEventListener('click', () => {
			assistantForm?.reset();
			assistantConversation = [];
			assistantWelcomeShown = false;
			assistantChatLog?.replaceChildren();
			if (assistantChat) assistantChat.hidden = false;
			if (assistantResults) assistantResults.hidden = true;
			setAssistantStatus('');
			showAssistantWelcome();
			assistantMessageField?.focus();
		});
	</script>
</BaseLayout>

