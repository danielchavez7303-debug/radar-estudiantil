---
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
	title="Página no encontrada | Radar Estudiantil"
	description="La página que buscas no está disponible en Radar Estudiantil."
>
	<main class="error-page" id="top">
		<section class="error-panel" aria-labelledby="error-title">
			<p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Error 404</p>
			<h1 id="error-title">Esta ruta se salió del radar.</h1>
			<p>La página que buscas no existe o cambió de lugar. Puedes volver al catálogo y empezar de nuevo.</p>
			<div class="error-actions">
				<a class="button" href={baseUrl}>Ir al inicio <span aria-hidden="true">↗</span></a>
				<a class="text-link" href={`${baseUrl}oportunidades`}>Explorar oportunidades <span aria-hidden="true">→</span></a>
			</div>
		</section>
	</main>
</BaseLayout>
