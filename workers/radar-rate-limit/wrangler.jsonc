{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "radar-estudiantil-rate-limit",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "durable_objects": {
    "bindings": [
      {
        "name": "RADAR_RATE_LIMIT",
        "class_name": "RadarRateLimit"
      }
    ]
  },
  "exports": {
    "RadarRateLimit": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
